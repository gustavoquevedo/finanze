# Copia este archivo a .env.local para usar Supabase en local (sin estas variables, la app usa localStorage).
# Son valores públicos: la clave "publishable" está pensada para el navegador; la seguridad la da RLS.
# Nunca pongas aquí la service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
